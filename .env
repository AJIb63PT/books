# API
# Относительный base URL проксируется через Vite dev-server
VITE_API_BASE_URL=/api/v1
# Target бэкенда (Yii2) для dev-proxy
VITE_PROXY_TARGET=http://localhost:8080

# SMS-уведомления (smspilot.ru)
# Ключ-эмулятор: реальная отправка SMS не происходит
VITE_SMSPILOT_API_KEY=EMULATOR
# Через /sms-pilot запрос проксируется Vite dev-server'ом (избегаем CORS)
VITE_SMSPILOT_ENDPOINT=/sms-pilot/api2.php